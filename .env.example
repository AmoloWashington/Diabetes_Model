# Copy to .env (git-ignored) and fill in. Never commit real keys.
USE_ANTHROPIC_DIRECT=true
ANTHROPIC_API_KEY=
# Primary model for the AI research assistant
CLAUDE_MODEL=claude-opus-5
# Effort for the assistant: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# Optional, requests per minute per client IP for /api/ai/*
AI_RATE_LIMIT_PER_MIN=12
