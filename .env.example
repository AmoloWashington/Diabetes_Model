# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- AI research assistant (Anthropic API) ---
USE_ANTHROPIC_DIRECT=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high            # low | medium | high | xhigh | max
AI_RATE_LIMIT_PER_MIN=12      # per client IP

# --- Kaggle (Dataset explorer) ---
# Create a token at kaggle.com -> Settings -> API. Either the new single token:
KAGGLE_API_TOKEN=
# ...or the legacy username/key pair:
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Storage (optional) ---
# Where the SQLite database and imported datasets live (default: backend/.data)
# GLUCOLAB_DATA_DIR=
